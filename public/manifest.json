{
  "name": "Doki Theme for F.F. (Fork)",
  "short_name": "Doki Theme (Fork)",
  "version": "88.3.2",
  "description": "Cute anime character themes.",
  "manifest_version": 2,
  "icons": {
    "48": "icons/doki-theme-logo@48.png",
    "96": "icons/doki-theme-logo@96.png"
  },
  "optional_permissions": [
    "search",
    "browserSettings",
    "tabs",
    "activeTab",
    "<all_urls>"
  ],
  "permissions": ["storage", "theme"],
  "background": {
    "scripts": ["js/background.js"]
  },
  "browser_action": {
    "browser_style": true,
    "default_icon": {
      "16": "icons/doki-theme-logo@16.png",
      "32": "icons/doki-theme-logo@32.png",
      "64": "icons/doki-theme-logo@64.png"
    },
    "default_popup": "popup.html",
    "default_title": "Doki Theme"
  },
  "chrome_url_overrides": {
    "newtab": "tab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "tab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "95.0",
      "id": "{9a72b801-6c8b-40fc-b419-51af60fa4b7b}",
      "update_url": "https://github.com/ZimCodes/doki-theme-firefox/refs/heads/main/update.json"
    }
  }
}
